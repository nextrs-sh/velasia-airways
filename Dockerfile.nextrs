#
# Velasia Airways storefront on NextRS (Rust server + embedded V8), from the npm distribution
# @nextrs/cli@0.1.0-rc.1. Milestone 8.
#
#   docker build -f Dockerfile.nextrs -t velasia-nextrs .
#   docker run --rm -p 8080:8080 -e RETAILING_API_URL=https://<api-host> \
#     -e SITE_URL=http://localhost:8080 velasia-nextrs
#
# One of two storefront images built from the same source (see Dockerfile.node and
# docs/deployment/). The `build` stage is byte-for-byte the one in Dockerfile.node: the same
# `next build` (output: 'standalone'), so a local BuildKit build gives both images the same
# build output and build id. NextRS serves that output as `next build` wrote it: the standalone
# server bundles, the traced node_modules they import (run in V8, never by Node.js), the
# `.next` manifests, `.next/static` and `public/`.
#
# Stages:
#   build           Next.js build (Node.js is used here only, to build).
#   nextrs-install  `npm ci` of docker/nextrs/package-lock.json (@nextrs/cli@0.1.0-rc.1 from
#                   registry.npmjs.org, integrity-pinned); checks the version and the native
#                   binary's sha256 against the package's BUILD-INFO.json. No compilation, no
#                   Rust toolchain anywhere.
#   nextrs-inspect  `nextrs inspect` on the build output, on the runtime base: the image build
#                   fails if NextRS cannot read it or the binary cannot load (glibc).
#   runtime         debian:12-slim (glibc 2.36; the binary needs glibc >= 2.35, linux/amd64
#                   only). The native binary, the build output, and docker/nextrs/start.sh.
#                   No Node.js, npm or pnpm: the image build fails if one is present.
#
# Portable Dockerfile syntax only (no BuildKit `RUN --mount`, `COPY --chmod` or heredocs), as in
# Dockerfile.node: App Platform's Dockerfile builder is not documented to support them.
#
# Build arguments: as Dockerfile.node (SITE_URL, VELASIA_TODAY), except VELASIA_DEPLOYMENT_ID,
# which NextRS 0.1.0-rc.1 cannot serve (the nextrs-inspect stage fails the build if it is set).
#
# Railway (Milestone 9, docs/deployment/railway.md): built from the repository root
# (RAILWAY_DOCKERFILE_PATH). Railway passes a service variable to a build only through an ARG of
# the same name, so the public arguments above are all a build receives; no secret has an ARG.
# The build prerenders from its own throwaway API (127.0.0.1), never the private network.
#
# Runtime contract: listens on 0.0.0.0:$PORT (default 8080); runs as uid 10001; SIGTERM stops
# accepting connections and gives in-flight requests NEXTRS_SHUTDOWN_GRACE seconds. All
# environment variables are documented in docker/nextrs/start.sh.

ARG NODE_IMAGE=node:24.18.0-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d
ARG RUNTIME_IMAGE=debian:12-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc

# ---------------------------------------------------------------------------------------------
# BEGIN shared build stage (identical in Dockerfile.node and Dockerfile.nextrs).
FROM ${NODE_IMAGE} AS build
ENV PNPM_HOME=/pnpm \
    CI=true \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    TURBO_TELEMETRY_DISABLED=1 \
    NEXT_TELEMETRY_DISABLED=1
RUN corepack enable
WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/retailing-api/package.json apps/retailing-api/
COPY apps/web/package.json apps/web/
COPY packages/config/package.json packages/config/
COPY packages/contracts/package.json packages/contracts/
COPY packages/observability/package.json packages/observability/
COPY packages/ui/package.json packages/ui/
RUN pnpm install --frozen-lockfile --filter "@velasia/web..." --filter "@velasia/retailing-api..."
COPY packages packages
COPY apps/retailing-api apps/retailing-api
COPY apps/web apps/web
ARG SITE_URL=http://localhost:8080
ARG VELASIA_DEPLOYMENT_ID=
ARG VELASIA_TODAY=
ARG VELASIA_NEXT_COMPRESS=
# Milestone 9: the build always prerenders from its own throwaway API on 127.0.0.1
# (apps/web/scripts/with-retailing-api.mjs, temporary TalaDB file), never from a deployed one:
# private networking (velasia-api.railway.internal) does not exist while an image builds, and the
# runtime service token is not a build input (empty here, so the throwaway API needs none).
ENV SITE_URL=${SITE_URL} \
    VELASIA_DEPLOYMENT_ID=${VELASIA_DEPLOYMENT_ID} \
    VELASIA_TODAY=${VELASIA_TODAY} \
    VELASIA_NEXT_COMPRESS=${VELASIA_NEXT_COMPRESS} \
    RETAILING_API_URL=http://127.0.0.1:4010 \
    RETAILING_API_SERVICE_TOKEN= \
    RETAILING_API_START_TIMEOUT_MS=180000
# An unresolved Railway reference (no generated domain yet) leaves an empty host or a literal
# `${{`: fail here rather than bake a broken origin into every page.
RUN case "$SITE_URL" in *'${{'* | *' '*) bad=1 ;; http://?* | https://?*) bad= ;; *) bad=1 ;; esac \
 && if [ -n "$bad" ]; then \
      echo "SITE_URL must be an absolute http(s) origin with a host, got '$SITE_URL'" \
           "(on Railway: generate the service domain before the first build)" >&2; exit 1; fi \
 && echo "SITE_URL baked into this build: $SITE_URL" \
 && pnpm --filter @velasia/web build
# The standalone server is complete (public/ and .next/static/ beside it), and the build-time
# API wrote only to a temporary directory: no database or .env file leaked in.
RUN test -f apps/web/.next/standalone/apps/web/server.js \
 && test -d apps/web/.next/standalone/apps/web/.next/static \
 && test -d apps/web/.next/standalone/apps/web/public \
 && ! find apps/web/.next/standalone -name '*.db' -o -name '.env*' | grep -q . \
 && node -p "'next ' + require('/repo/apps/web/node_modules/next/package.json').version" \
      > apps/web/.next/standalone/next-version.txt \
 && echo "build id: $(cat apps/web/.next/standalone/apps/web/.next/BUILD_ID)"
# END shared build stage.
# ---------------------------------------------------------------------------------------------

FROM ${NODE_IMAGE} AS nextrs-install
WORKDIR /nextrs
COPY docker/nextrs/package.json docker/nextrs/package-lock.json ./
# --ignore-scripts: the package declares none; this guarantees nothing runs on install.
RUN npm ci --no-audit --no-fund --ignore-scripts --registry=https://registry.npmjs.org/
# bin/nextrs is a shell launcher; native/nextrs is the binary that BUILD-INFO.json describes.
RUN set -eu; pkg=node_modules/@nextrs/cli; \
    v=$(node -p "require('./$pkg/package.json').version"); \
    [ "$v" = "0.1.0-rc.1" ] || { echo "expected @nextrs/cli 0.1.0-rc.1, got $v" >&2; exit 1; }; \
    echo "$(node -p "require('./$pkg/BUILD-INFO.json').binary_sha256")  $pkg/native/nextrs" | sha256sum -c -; \
    out=$("$pkg/native/nextrs" --version); echo "$out"; \
    [ "$out" = "nextrs 0.1.0-rc.1" ] || { echo "unexpected --version: $out" >&2; exit 1; }; \
    mkdir -p /out/doc; \
    install -m 0755 "$pkg/native/nextrs" /out/nextrs; \
    cp "$pkg/package.json" /out/doc/npm-package.json; \
    cp "$pkg/BUILD-INFO.json" "$pkg/LICENSE-MIT" "$pkg/LICENSE-APACHE" \
       "$pkg/THIRD-PARTY.md" "$pkg/THIRD-PARTY-LICENSES.txt" /out/doc/

# ---------------------------------------------------------------------------------------------
FROM ${RUNTIME_IMAGE} AS nextrs-inspect
# `nextrs inspect` must read the build. It also passes builds that `nextrs start` 0.1.0-rc.1
# then refuses: routes-manifest `onMatchHeaders`, which Next.js emits for `deploymentId`
# (VELASIA_DEPLOYMENT_ID). That fails here, at build time, instead of at startup.
COPY --from=nextrs-install /out/nextrs /usr/local/bin/nextrs
COPY --from=build /repo/apps/web/.next/standalone /app
RUN set -eu; mkdir -p /out; \
    /usr/local/bin/nextrs inspect /app/apps/web > /out/inspect.txt 2>&1 \
      || { cat /out/inspect.txt; echo "nextrs inspect failed" >&2; exit 1; }; \
    cat /out/inspect.txt; \
    if tr -d '[:space:]' < /app/apps/web/.next/routes-manifest.json | grep -q '"onMatchHeaders":\[{'; then \
      echo "VELASIA_DEPLOYMENT_ID (Next.js deploymentId) is not supported by NextRS 0.1.0-rc.1:" \
           "build without it (see docs/deployment/runtime-parity-report.md)" >&2; exit 1; \
    fi

# ---------------------------------------------------------------------------------------------
FROM ${RUNTIME_IMAGE} AS runtime
LABEL org.opencontainers.image.title="velasia-nextrs" \
      org.opencontainers.image.description="Velasia Airways storefront on NextRS @nextrs/cli@0.1.0-rc.1 (fictional demo; no real reservations or payments)" \
      org.opencontainers.image.source="https://github.com/nextrs-sh/velasia-airways" \
      org.opencontainers.image.licenses="MIT" \
      dev.velasia.runtime="nextrs" \
      dev.nextrs.npm-package="@nextrs/cli@0.1.0-rc.1" \
      dev.nextrs.binary-sha256="44f04e586c7dc9eb0b8f69dfd992143f725472aa5f3619df5a4039d77d2c6956"
# Security updates for the base image's packages. NextRS links only libc, libm, libgcc_s and
# the loader, and carries its own TLS roots (webpki-roots): no extra packages are needed.
RUN apt-get update \
 && apt-get -y --no-install-recommends upgrade \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --user-group --home-dir /nonexistent --shell /usr/sbin/nologin nextrs \
 && install -d -o nextrs -g nextrs -m 0700 /var/cache/nextrs
ENV PORT=8080 \
    NEXTRS_LOG_FORMAT=json
COPY --from=nextrs-install /out/nextrs /usr/local/bin/nextrs
COPY --from=nextrs-install /out/doc/ /usr/share/doc/nextrs/
COPY --from=nextrs-inspect /out/inspect.txt /usr/share/doc/nextrs/velasia-inspect.txt
COPY docker/nextrs/start.sh /usr/local/bin/velasia-nextrs-start
# Application files belong to root and are read-only for the `nextrs` user.
COPY --from=build /repo/apps/web/.next/standalone /app
RUN chmod 0755 /usr/local/bin/velasia-nextrs-start \
 && ! command -v node && ! command -v npm && ! command -v pnpm \
 && echo "no Node.js in the runtime image" \
 && /usr/local/bin/nextrs --version > /app/nextrs-version.txt
USER nextrs
EXPOSE 8080
# Docker's own health check (App Platform uses its HTTP health check instead; same path). No
# curl/wget/node here: bash's /dev/tcp asks the storefront's liveness route.
HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=3 \
  CMD ["bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/${PORT:-8080} && printf 'GET /api/internal/health/live HTTP/1.1\\r\\nHost: localhost\\r\\nConnection: close\\r\\n\\r\\n' >&3 && head -n1 <&3 | grep -q ' 200 '"]
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/velasia-nextrs-start"]
