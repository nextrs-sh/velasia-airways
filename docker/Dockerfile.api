#
# Velasia Airways — retailing API (Fastify + embedded TalaDB). Milestone 7.
#
#   docker build -f docker/Dockerfile.api -t velasia-api .
#
# - Pinned Node.js base (tag + digest). linux/amd64 only: TalaDB 0.13 ships prebuilt Node
#   bindings for linux-x64-gnu (glibc >= 2.34) but not for linux-arm64 or musl, so the image is
#   Debian bookworm (glibc 2.36), never Alpine. Nothing is compiled or downloaded at startup.
# - Dependencies come from the committed lockfile (`--frozen-lockfile`).
# - The runtime stage holds the esbuild bundle, the production dependencies (TalaDB, Argon2
#   native bindings and their JS), and Node itself: no TypeScript, tsx, pnpm, npm, or corepack.
# - Runs as the unprivileged `node` user; the database lives on a volume at /data.
# - Milestone 8: portable Dockerfile syntax only (no BuildKit `RUN --mount`), so DigitalOcean App
#   Platform can build it too (docs/deployment/digitalocean-app-platform.md).
# - Milestone 9 (Railway, docs/deployment/railway.md): docker/api/start.sh is the entrypoint. It
#   checks the TalaDB directory and execs the API as `node`; started as root (Railway's
#   RAILWAY_RUN_UID=0, because Railway mounts volumes root-owned) it first gives the TalaDB
#   directory to `node`, then drops privileges. TALADB_REQUIRE_VOLUME=enabled refuses to start
#   without a mounted volume. Nothing is initialised at build time: volumes exist only at runtime.

ARG NODE_IMAGE=node:24.18.0-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d

FROM ${NODE_IMAGE} AS base
ENV PNPM_HOME=/pnpm \
    CI=true \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    TURBO_TELEMETRY_DISABLED=1
RUN corepack enable
WORKDIR /repo

# ---------------------------------------------------------------------------
FROM base AS build
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/retailing-api/package.json apps/retailing-api/
COPY apps/web/package.json apps/web/
COPY packages/config/package.json packages/config/
COPY packages/contracts/package.json packages/contracts/
COPY packages/observability/package.json packages/observability/
COPY packages/ui/package.json packages/ui/
RUN pnpm install --frozen-lockfile --filter "@velasia/retailing-api..."
COPY packages/config packages/config
COPY packages/contracts packages/contracts
COPY packages/observability packages/observability
COPY apps/retailing-api apps/retailing-api
RUN pnpm --filter @velasia/retailing-api build
# Production dependencies only, resolved from the lockfile.
RUN pnpm --filter @velasia/retailing-api deploy --prod --legacy /out \
 && cp -r apps/retailing-api/dist /out/dist

# ---------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS runtime
LABEL org.opencontainers.image.title="velasia-retailing-api" \
      org.opencontainers.image.description="Velasia Airways retailing API (fictional demo; no real reservations or payments)" \
      org.opencontainers.image.source="https://github.com/nextrs-sh/velasia-airways" \
      org.opencontainers.image.licenses="MIT"
ENV NODE_ENV=production \
    RETAILING_API_HOST=0.0.0.0 \
    RETAILING_API_PORT=4010 \
    TALADB_PATH=/data/velasia.db \
    LOG_LEVEL=info
WORKDIR /app
# Security updates from Debian for the base image's packages (the Node.js image lags behind
# Debian point releases), then package managers are removed: none in the runtime image.
RUN apt-get update \
 && apt-get -y --no-install-recommends upgrade \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
           /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
           /opt/yarn-* /usr/local/bin/yarn /usr/local/bin/yarnpkg \
 && mkdir -p /data /backups \
 && chown node:node /data /backups \
 && chmod 0700 /data /backups
# Application files belong to root and are read-only for the `node` user.
COPY --from=build /out/node_modules ./node_modules
COPY --from=build /out/dist ./dist
COPY --from=build /out/package.json ./package.json
COPY docker/api/start.sh /usr/local/bin/velasia-api-start
# Fail the build (not the first request) if a native binding is missing for this platform.
RUN chmod 0755 /usr/local/bin/velasia-api-start \
 && node -e "require('@taladb/node'); require('@node-rs/argon2'); console.log('native bindings ok')"
USER node
# Milestone 9: no VOLUME instruction. Railway does not document it (its volumes are attached by
# the platform), and every compose file mounts /data explicitly; TALADB_REQUIRE_VOLUME=enabled
# makes a missing mount a startup error instead of an anonymous volume.
EXPOSE 4010
HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:4010/health/ready').then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]
STOPSIGNAL SIGTERM
# The entrypoint execs CMD, so the API is PID 1 and handles SIGTERM itself.
ENTRYPOINT ["/usr/local/bin/velasia-api-start"]
CMD ["node", "--enable-source-maps", "dist/server.mjs"]
