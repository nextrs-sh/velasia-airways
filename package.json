{
  "name": "velasia-airways",
  "private": true,
  "description": "Velasia Airways \u2014 a fictional premium airline retailing demo built with Next.js.",
  "license": "MIT",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck && tsc -p tests/e2e",
    "test": "turbo run test",
    "test:e2e": "turbo run build --filter=@velasia/web && playwright test",
    "test:bench": "node --test benchmarks/railway/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:build": "sh scripts/docker/compose.sh build",
    "docker:up": "sh scripts/docker/compose.sh up -d --wait",
    "docker:down": "sh scripts/docker/compose.sh down",
    "docker:logs": "sh scripts/docker/compose.sh logs -f --tail=200",
    "docker:smoke": "node scripts/docker/smoke.mjs",
    "docker:backup": "sh scripts/docker/backup.sh",
    "docker:restore": "sh scripts/docker/restore.sh",
    "docker:verify-db": "sh scripts/docker/verify-db.sh",
    "test:docker": "playwright test -c playwright.docker.config.ts",
    "dual:up": "docker compose -f compose.dual-runtime.yaml up --build -d --wait",
    "dual:down": "docker compose -f compose.dual-runtime.yaml down --volumes",
    "test:parity": "playwright test -c playwright.parity.config.ts",
    "railway:check": "tsc -p .railway && node scripts/railway/check-iac.mjs",
    "test:railway": "node --test scripts/railway/*.test.mjs",
    "railway:plan-gate": "node scripts/railway/plan-gate.mjs",
    "railway:deployments": "node scripts/railway/deployments.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "railway": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
